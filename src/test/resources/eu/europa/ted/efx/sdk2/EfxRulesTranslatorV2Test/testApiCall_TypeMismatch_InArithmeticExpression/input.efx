// Intentionally invalid: using a boolean API function in an arithmetic expression.
// The compiler should throw a type mismatch exception.

ENDPOINT 'default' AT 'https://api.ted.europa.eu/v1';

LET dynamic : ?check(text : $id) CALL API;

---- STAGE 1a ----

WITH BT-00-Text
    ASSERT 1 + ?check(BT-00-Identifier) == 2
    AS ERROR R-K7P-M2Q
    FOR BT-00-Text IN 1
