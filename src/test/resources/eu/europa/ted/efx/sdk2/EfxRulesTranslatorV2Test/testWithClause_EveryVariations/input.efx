// Test: variations of WITH EVERY.
// - Stage 1a: lower-case keywords, and a predicate written after the node. Only the node's
//   own predicate is dropped; the written predicate stays on the rule context.
// - Stage 1b: a context variable. The variable holds the widened context (value ".").
// - Stage 2a: a field whose path has a predicate on its last step. The rule context drops it.
// - Stage 2b: a sibling node with another predicate on the same element. Both give the same
//   rule context, and each reads its own fields without its predicate.
// - Stage 3a: an absolute node reference.
// - Stage 3b: a context variable bound to a field.
// - Stage 4a: an attribute field, which has no predicate: same rule context as without EVERY.
// - Stages 4b and 4c: the same rule set with and without EVERY, with a variable and a WHEN
//   condition. Only the rule context differs.

---- STAGE 1a ----

with every ND-PrivacyInRepeatableNode[BT-197(BT-00)-Text-In-Repeatable-Node is present]
    ASSERT BT-198(BT-00)-Text-In-Repeatable-Node is present
    AS ERROR R-EVR-002
    FOR BT-198(BT-00)-Text-In-Repeatable-Node IN 1

---- STAGE 1b ----

WITH EVERY context : $priv = ND-PrivacyInRepeatableNode
    ASSERT BT-197(BT-00)-Text-In-Repeatable-Node is present
    AS ERROR R-EVR-003
    FOR BT-197(BT-00)-Text-In-Repeatable-Node IN 1

---- STAGE 2a ----

WITH EVERY BT-01-SubSubNode-Text
    ASSERT BT-01-SubSubNode-Text is present
    AS ERROR R-EVR-004
    FOR BT-01-SubSubNode-Text IN 1

---- STAGE 2b ----

WITH EVERY ND-PrivacyInRepeatableNode2
    ASSERT BT-197(BT-00)-Number-In-Repeatable-Node is present
    AS ERROR R-EVR-005
    FOR BT-197(BT-00)-Number-In-Repeatable-Node IN 1

---- STAGE 3a ----

WITH EVERY /ND-PrivacyInRepeatableNode
    ASSERT BT-197(BT-00)-Text-In-Repeatable-Node is present
    AS ERROR R-EVR-006
    FOR BT-197(BT-00)-Text-In-Repeatable-Node IN 1

---- STAGE 3b ----

WITH EVERY context : $text = BT-01-SubSubNode-Text
    ASSERT BT-01-SubSubNode-Text is present
    AS ERROR R-EVR-007
    FOR BT-01-SubSubNode-Text IN 1

---- STAGE 4a ----

WITH EVERY BT-00-Attribute
    ASSERT BT-00-Attribute is present
    AS ERROR R-EVR-008
    FOR BT-00-Attribute IN 1

---- STAGE 4b ----

WITH EVERY ND-PrivacyInRepeatableNode, text : $reason = BT-197(BT-00)-Text-In-Repeatable-Node
    WHEN BT-198(BT-00)-Text-In-Repeatable-Node is present
    ASSERT $reason != ''
    AS ERROR R-EVR-010
    FOR BT-197(BT-00)-Text-In-Repeatable-Node IN 1

---- STAGE 4c ----

WITH ND-PrivacyInRepeatableNode, text : $reason = BT-197(BT-00)-Text-In-Repeatable-Node
    WHEN BT-198(BT-00)-Text-In-Repeatable-Node is present
    ASSERT $reason != ''
    AS ERROR R-EVR-011
    FOR BT-197(BT-00)-Text-In-Repeatable-Node IN 1
